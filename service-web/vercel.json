{
  "version": 2,
  "builds": [
    { "src": "service-analytics/main.py", "use": "@vercel/python" },
    { "src": "service-web/server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/etl/(.*)", "dest": "service-analytics/main.py" },
    { "src": "/api/analytics/(.*)", "dest": "service-analytics/main.py" },
    { "src": "/api/v1/etl/(.*)", "dest": "service-analytics/main.py" },
    { "src": "/api/v1/analytics/(.*)", "dest": "service-analytics/main.py" },
    { "src": "/(.*)", "dest": "service-web/server.js" }
  ]
}